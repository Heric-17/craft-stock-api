generator client {
  provider     = "prisma-client"
  output       = "../src/shared/infrastructure/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
}

// A session, not a historical record — section 9's "never Cascade" rule does
// not apply here. A deleted User leaves nothing worth keeping a token for.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 of the raw token. The raw value exists only once, in the
  // response that issues it, same principle as a password: only ever the
  // hash is persisted.
  tokenHash String    @unique
  expiresAt DateTime
  // Set the moment the token is rotated away or logged out. Absence, not a
  // boolean column, is what says "active" — same pattern as
  // Material.discontinuedAt.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Materials -----------------------------------------------------------

// Base units only, so every persisted quantity means the same thing without a
// conversion table: a 1 kg bag is a packageQuantity of 1000 in GRAM. Reading
// that back as "1,5 kg" is the interface's business.
enum ConsumptionUnit {
  UNIT
  GRAM
  MILLILITER
  CENTIMETER
}

model Material {
  id                String    @id @default(uuid())
  name              String
  description       String?
  imageUrl          String?
  packageCost       Decimal   @db.Decimal(12, 2)
  packageQuantity   Decimal   @db.Decimal(12, 3)
  // The unit packageQuantity, stockQuantity, minimumStockAlert and every
  // BomItem quantity are expressed in.
  consumptionUnit   ConsumptionUnit
  stockQuantity     Decimal   @db.Decimal(12, 3)
  minimumStockAlert Decimal   @db.Decimal(12, 3)
  discontinuedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  priceHistory   MaterialPriceHistory[]
  bomItems       BomItem[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovementSnapshot[]

  // Materials are looked up by name constantly: BOM authoring, purchase entry,
  // NFC-e item matching.
  @@index([name])
}

enum PriceChangeOrigin {
  CREATION
  MANUAL_EDIT
  INVOICE_SYNC
}

model MaterialPriceHistory {
  id            String            @id @default(uuid())
  materialId    String
  previousValue Decimal           @db.Decimal(12, 2)
  newValue      Decimal           @db.Decimal(12, 2)
  origin        PriceChangeOrigin
  changedAt     DateTime          @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Composite products & bill of materials -------------------------------

model CompositeProduct {
  id                   String    @id @default(uuid())
  name                 String
  description          String?
  imageUrl             String?
  fixedOperationalCost Decimal   @db.Decimal(12, 2)
  profitMargin         Decimal   @db.Decimal(5, 2)
  manualPrice          Decimal?  @db.Decimal(12, 2)
  discontinuedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  billOfMaterials BillOfMaterials?
  saleItems       SaleItem[]
}

model BillOfMaterials {
  id                 String @id @default(uuid())
  compositeProductId String @unique

  compositeProduct CompositeProduct @relation(fields: [compositeProductId], references: [id], onDelete: Restrict)
  items            BomItem[]
}

model BomItem {
  id                String  @id @default(uuid())
  billOfMaterialsId String
  materialId        String
  quantity          Decimal @db.Decimal(12, 3)

  billOfMaterials BillOfMaterials @relation(fields: [billOfMaterialsId], references: [id], onDelete: Restrict)
  material        Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Sales -----------------------------------------------------------------
// paymentStatus and productionStatus are two independent state axes and are
// deliberately modeled as two separate enums, never combined into one.

enum PaymentStatus {
  PENDING
  PAID
}

enum ProductionStatus {
  PENDING
  ASSEMBLED
  DELIVERED
}

model Sale {
  id               String           @id @default(uuid())
  customerName     String
  customerContact  String?
  paymentMethod    String
  paymentStatus    PaymentStatus    @default(PENDING)
  productionStatus ProductionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items          SaleItem[]
  stockMovements StockMovementSnapshot[]
}

model SaleItem {
  id                 String  @id @default(uuid())
  saleId             String
  // A SaleItem references either a CompositeProduct or a loose Material,
  // never both and never neither — enforced in the domain entity, not here.
  // The FK stays for navigation/traceability only — every read displays the
  // snapshot below, never the referenced entity's current name or price.
  compositeProductId String?
  materialId         String?
  quantity           Decimal @db.Decimal(12, 3)
  itemNameSnapshot   String
  // The frozen price, kept as the fraction it is instead of the per-unit
  // figure it divides out to: the amount of a reference quantity, and that
  // quantity. A CompositeProduct freezes its finalPrice over 1; a loose
  // Material freezes the marked-up cost of a whole package over the
  // packageQuantity that package holds. Dividing here would round the price
  // of a gram or a millilitre up to a whole cent and overcharge every
  // fractional sale -- R$ 3,60 for 120 g of flour that should cost R$ 3,36.
  // The line total is derived from the pair at read time, never stored.
  priceBasisAmount   Decimal @db.Decimal(12, 2)
  priceBasisQuantity Decimal @db.Decimal(12, 3)

  sale             Sale              @relation(fields: [saleId], references: [id])
  compositeProduct CompositeProduct? @relation(fields: [compositeProductId], references: [id], onDelete: Restrict)
  material         Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// Records, per sale, exactly how much of each Material was debited from
// stock — what allows an exact reversal on cancellation.
model StockMovementSnapshot {
  id              String   @id @default(uuid())
  saleId          String
  materialId      String
  quantityDebited Decimal  @db.Decimal(12, 3)
  createdAt       DateTime @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Purchases ---------------------------------------------------------

enum DiscountAllocationMode {
  PROPORTIONAL
  COMPANY_ONLY
  PERSONAL_ONLY
  MANUAL
}

model Purchase {
  id                     String                 @id @default(uuid())
  purchaseDate           DateTime               @default(now())
  // 44-digit NFC-e access key. Null for purchases entered manually. Unique so
  // it can be used to deduplicate NFC-e imports.
  accessKey              String?                @unique @db.Char(44)
  // Raw, immutable return of the NFC-e extraction. Never mutated after
  // creation, even when only part of the items become stock Materials.
  rawInvoiceData         Json?
  // The establishment, in columns of its own rather than read back out of
  // rawInvoiceData. Two reasons, and neither is convenience: a purchase
  // entered by hand has no rawInvoiceData at all and would be invisible to
  // every filter and ranking, and the snapshot is a frozen fact that the
  // spending panel must not be made to depend on for a dimension it groups
  // and filters by. merchantCnpj is the stable identity of a shop across
  // notes; the name is what is shown, and shops do rename themselves.
  merchantName           String?
  merchantCnpj           String?
  // Header totals as the invoice reports them, not as a sum recomputed from
  // the lines: they are captured facts, in the same class as rawInvoiceData.
  // netTotal is what the company actually paid and is what the spending
  // panel aggregates; grossTotal is the replacement-cost side and feeds no
  // spending figure. discountTotal is exposed to the user as the period's
  // savings.
  grossTotal             Decimal                @db.Decimal(12, 2)
  discountTotal          Decimal                @db.Decimal(12, 2)
  netTotal               Decimal                @db.Decimal(12, 2)
  // How the note's discount is attributed to the lines. The NFC-e reports the
  // discount on the total and never says which item it belongs to, so the
  // choice is the user's and is recorded per purchase.
  discountAllocationMode DiscountAllocationMode @default(PROPORTIONAL)
  // True while a MANUAL attribution has been invalidated by an edit to the
  // lines and the user has not restated it. A purchase in this state is kept
  // out of the spending panel: a period computed with only part of the
  // discount attributed is wrong and looks fine.
  allocationPending      Boolean                @default(false)
  createdAt              DateTime               @default(now())

  pendingInvoices PendingInvoice[]

  items PurchaseItem[]

  // The spending dataset buckets purchases by date over a closed period.
  @@index([purchaseDate])
  // Both the establishment filter of the listing and the establishment
  // dimension of the dataset read this alongside the period.
  @@index([merchantCnpj])
}

model PurchaseItem {
  id                String  @id @default(uuid())
  purchaseId        String
  // Set only when isStockMaterial is true.
  materialId        String?
  // The merchant's own product code, when the line came from an NFC-e. It is
  // what the printed lines of a weighed item are folded together by.
  code              String?
  description       String
  quantity          Decimal @db.Decimal(12, 3)
  // The unit as the note printed it (UND9, KG9, PCT9). Kept for display while
  // the user classifies the line, and never used to derive packageQuantity:
  // the note calls a package of cheese one package, while stock cares about
  // the 200 g inside it, and only the user knows that.
  unit              String?
  unitPrice         Decimal @db.Decimal(12, 2)
  // grossValue is the line total the invoice itself reports — a captured
  // fact, which the issuer may round a cent away from quantity × unitPrice —
  // and it is the only figure allowed to feed a Material's packageCost.
  grossValue        Decimal @db.Decimal(12, 2)
  // This line's share of the note's discount. Persisted, and deliberately so:
  // in PROPORTIONAL, COMPANY_ONLY and PERSONAL_ONLY it is computed, but in
  // MANUAL it is the user's direct input and derives from nothing at all.
  // netValue is NOT a column — it is grossValue minus this, on every read.
  allocatedDiscount Decimal @default(0) @db.Decimal(12, 2)
  // Independent flags: being a stock Material implies being a company
  // expense, but the reverse does not hold (e.g. packaging, rent).
  isCompanyExpense  Boolean @default(true)
  isStockMaterial   Boolean @default(false)

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- NFC-e import --------------------------------------------------------

enum PendingInvoiceStatus {
  PENDING
  UNSTABLE
  IMPORTED
}

// --- Audit trail & request log --------------------------------------------
// Captured automatically by a Prisma client extension in infrastructure/,
// never written to by application code. See §15.2 of CLAUDE.md.

enum AuditOperation {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id            String         @id @default(uuid())
  occurredAt    DateTime       @default(now())
  // Groups every AuditLog row written during the same request with the
  // RequestLog row for that request — not a Postgres transaction id, just
  // the correlation key both specs call transactionId.
  transactionId String
  userId        String?
  route         String
  httpMethod    String
  correlationId String
  entityType    String
  entityId      String
  entityLabel   String?
  operation     AuditOperation
  // { field: { old, new } } for only the fields that actually changed.
  // Sensitive fields (password/hash/token/cpf) are omitted entirely.
  changes       Json
  // Optional, set by the handful of services where the diff alone doesn't
  // distinguish intent. Never required for a row to be written.
  intent        String?

  @@index([entityType, entityId])
  @@index([userId, occurredAt])
  @@index([transactionId])
}

// One row per mutating request, written whether or not it produced any
// AuditLog rows — a route that touched nothing is itself an investigation
// fact. Written outside the business transaction, like ErrorLog: a rollback
// must not erase the record that the attempt happened.
model RequestLog {
  id            String   @id @default(uuid())
  transactionId String   @unique
  occurredAt    DateTime @default(now())
  route         String
  httpMethod    String
  userId        String?
  correlationId String
  statusCode    Int
  durationMs    Int
  // Set only when statusCode >= 500, and always equal to correlationId
  // (§15.1). A separate column because it's what a user-facing error
  // actually hands back for someone to search by.
  errorId       String?

  @@index([correlationId])
  @@index([errorId])
}

model PendingInvoice {
  id            String               @id @default(uuid())
  url           String
  status        PendingInvoiceStatus @default(PENDING)
  attemptCount  Int                  @default(0)
  lastAttemptAt DateTime?
  // The Purchase this capture became, set once the import succeeded. It is
  // what lets a duplicate capture point the user at the purchase that already
  // exists instead of creating a second one.
  purchaseId    String?
  // Why the last attempt failed, for the pending list. A message, never a stack.
  lastError     String?
  createdAt     DateTime             @default(now())

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  // Polled by the import job to pick up everything still awaiting processing.
  @@index([status])
}
