generator client {
  provider     = "prisma-client"
  output       = "../src/shared/infrastructure/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Materials -----------------------------------------------------------

model Material {
  id                String    @id @default(uuid())
  name              String
  description       String?
  imageUrl          String?
  packageCost       Decimal   @db.Decimal(12, 2)
  packageQuantity   Decimal   @db.Decimal(12, 3)
  stockQuantity     Decimal   @db.Decimal(12, 3)
  minimumStockAlert Decimal   @db.Decimal(12, 3)
  discontinuedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  priceHistory   MaterialPriceHistory[]
  bomItems       BomItem[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovementSnapshot[]

  // Materials are looked up by name constantly: BOM authoring, purchase entry,
  // NFC-e item matching.
  @@index([name])
}

enum PriceChangeOrigin {
  CREATION
  MANUAL_EDIT
  INVOICE_SYNC
}

model MaterialPriceHistory {
  id            String            @id @default(uuid())
  materialId    String
  previousValue Decimal           @db.Decimal(12, 2)
  newValue      Decimal           @db.Decimal(12, 2)
  origin        PriceChangeOrigin
  changedAt     DateTime          @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Composite products & bill of materials -------------------------------

model CompositeProduct {
  id                   String    @id @default(uuid())
  name                 String
  description          String?
  imageUrl             String?
  fixedOperationalCost Decimal   @db.Decimal(12, 2)
  profitMargin         Decimal   @db.Decimal(5, 2)
  manualPrice          Decimal?  @db.Decimal(12, 2)
  discontinuedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  billOfMaterials BillOfMaterials?
  saleItems       SaleItem[]
}

model BillOfMaterials {
  id                 String @id @default(uuid())
  compositeProductId String @unique

  compositeProduct CompositeProduct @relation(fields: [compositeProductId], references: [id], onDelete: Restrict)
  items            BomItem[]
}

model BomItem {
  id                String  @id @default(uuid())
  billOfMaterialsId String
  materialId        String
  quantity          Decimal @db.Decimal(12, 3)

  billOfMaterials BillOfMaterials @relation(fields: [billOfMaterialsId], references: [id], onDelete: Restrict)
  material        Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Sales -----------------------------------------------------------------
// paymentStatus and productionStatus are two independent state axes and are
// deliberately modeled as two separate enums, never combined into one.

enum PaymentStatus {
  PENDING
  PAID
}

enum ProductionStatus {
  PENDING
  ASSEMBLED
  DELIVERED
}

model Sale {
  id               String           @id @default(uuid())
  customerName     String
  customerContact  String?
  paymentMethod    String
  paymentStatus    PaymentStatus    @default(PENDING)
  productionStatus ProductionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items          SaleItem[]
  stockMovements StockMovementSnapshot[]
}

model SaleItem {
  id                 String  @id @default(uuid())
  saleId             String
  // A SaleItem references either a CompositeProduct or a loose Material,
  // never both and never neither — enforced in the domain entity, not here.
  // The FK stays for navigation/traceability only — every read displays the
  // snapshot below, never the referenced entity's current name or price.
  compositeProductId String?
  materialId         String?
  quantity           Decimal @db.Decimal(12, 3)
  itemNameSnapshot   String
  unitPriceSnapshot  Decimal @db.Decimal(12, 2)

  sale             Sale              @relation(fields: [saleId], references: [id])
  compositeProduct CompositeProduct? @relation(fields: [compositeProductId], references: [id], onDelete: Restrict)
  material         Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// Records, per sale, exactly how much of each Material was debited from
// stock — what allows an exact reversal on cancellation.
model StockMovementSnapshot {
  id              String   @id @default(uuid())
  saleId          String
  materialId      String
  quantityDebited Decimal  @db.Decimal(12, 3)
  createdAt       DateTime @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- Purchases ---------------------------------------------------------

model Purchase {
  id             String   @id @default(uuid())
  purchaseDate   DateTime @default(now())
  // 44-digit NFC-e access key. Null for purchases entered manually. Unique so
  // it can be used to deduplicate NFC-e imports.
  accessKey      String?  @unique @db.Char(44)
  // Raw, immutable return of the NFC-e extraction. Never mutated after
  // creation, even when only part of the items become stock Materials.
  rawInvoiceData Json?
  // Header totals as the invoice reports them, not as a sum recomputed from
  // the lines: they are captured facts, in the same class as rawInvoiceData.
  // netTotal is what the company actually paid and is what the spending
  // panel aggregates; grossTotal is the replacement-cost side and feeds no
  // spending figure. discountTotal is exposed to the user as the period's
  // savings.
  grossTotal     Decimal  @db.Decimal(12, 2)
  discountTotal  Decimal  @db.Decimal(12, 2)
  netTotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  items PurchaseItem[]

  // The spending dataset buckets purchases by date over a closed period.
  @@index([purchaseDate])
}

model PurchaseItem {
  id               String  @id @default(uuid())
  purchaseId       String
  // Set only when isStockMaterial is true.
  materialId       String?
  description      String
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  // Both sides of the line are stored, and neither is a derived value kept
  // in sync with something else. grossValue is the line total the invoice
  // itself reports — a captured fact, which the issuer may round a cent
  // away from quantity × unitPrice — and it is the only figure allowed to
  // feed a Material's packageCost. netValue is what was actually paid for
  // the line after the note's discount is spread proportionally, and cannot
  // be recomputed from this row alone: the rounding residue of that spread
  // depends on every other line of the same note.
  grossValue       Decimal @db.Decimal(12, 2)
  netValue         Decimal @db.Decimal(12, 2)
  // Independent flags: being a stock Material implies being a company
  // expense, but the reverse does not hold (e.g. packaging, rent).
  isCompanyExpense Boolean @default(true)
  isStockMaterial  Boolean @default(false)

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// --- NFC-e import --------------------------------------------------------

enum PendingInvoiceStatus {
  PENDING
  UNSTABLE
  IMPORTED
}

model PendingInvoice {
  id            String               @id @default(uuid())
  url           String
  status        PendingInvoiceStatus @default(PENDING)
  attemptCount  Int                  @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime             @default(now())

  // Polled by the import job to pick up everything still awaiting processing.
  @@index([status])
}
