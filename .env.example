# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (matches the credentials in docker-compose.yml).
# POSTGRES_PORT is read by docker-compose only; move it if 5432 is already taken
# on the host, and keep DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://craftstock:craftstock@localhost:5432/craftstock?schema=public"

# NFC-e import
NFCE_PROVIDER=AUTO
NFCE_IMPORT_MAX_ATTEMPTS=3
NFCE_IMPORT_RETRY_DELAY_MS=1000

# Authentication (dev-only secret; every installation must set its own in production)
JWT_SECRET=c998409c9284a13c9e72a7a889534fe1cfb8f7496e2d8a8953f1d43a8b8acede
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
ARGON2_TIME_COST=3

# Audit trail retention (§15.2)
AUDIT_LOG_RETENTION_DAYS=180
REQUEST_LOG_RETENTION_DAYS=30

# Image storage (Materials & CompositeProducts)

# LOCAL_DISK || S3
STORAGE_PROVIDER=LOCAL_DISK
UPLOADS_DIR=./uploads
MAX_IMAGE_UPLOAD_SIZE_BYTES=5242880

S3_BUCKET_NAME=craftstock-images
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Operational alerts (unhandled errors, and the NFC-e source canary)

# CONSOLE writes the alert to the structured log; SMTP mails it.
NOTIFICATION_SENDER=CONSOLE
# How long one error type stays quiet after an alert for it went out.
ERROR_ALERT_THROTTLE_SECONDS=300

# Required only when NOTIFICATION_SENDER=SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# One address, or several separated by commas.
ALERT_EMAIL_TO=
