# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Browser clients (SPA)

# Origins the frontend is served from, separated by commas. Never a wildcard:
# the API answers with Access-Control-Allow-Credentials, and no browser accepts
# that together with "*". Empty in development falls back to the Vite dev
# server (http://localhost:5173 and http://127.0.0.1:5173). REQUIRED in
# production: without it the API starts and every browser call fails, with
# nothing on the server side to say why.
CORS_ORIGINS=

# Absolute base the web app is served at, which the link in the password reset
# e-mail points at. Empty in development falls back to http://localhost:5173.
# REQUIRED in production when EMAIL_SENDER=SMTP, with no default on purpose: a
# forgotten localhost there would mail out links that open nothing. Not needed
# by an installation used only as an API.
WEB_APP_URL=

# Absolute base this API is reached at from a browser, used to build the URL of
# a locally stored image. Empty in development falls back to
# http://localhost:<PORT>. REQUIRED in production, with no default on purpose:
# a forgotten localhost there would serve every client an image URL pointing at
# the client's own machine.
PUBLIC_BASE_URL=

# Database (matches the credentials in docker-compose.yml).
# POSTGRES_PORT is read by docker-compose only; move it if 5432 is already taken
# on the host, and keep DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://craftstock:craftstock@localhost:5432/craftstock?schema=public"

# NFC-e import
NFCE_PROVIDER=AUTO
NFCE_IMPORT_MAX_ATTEMPTS=3
NFCE_IMPORT_RETRY_DELAY_MS=1000

# NFC-e extraction canary: URLs of two or three reference notes, issued on
# clearly different dates, separated by commas or whitespace. What each one has
# to extract to is pinned in code, in
# src/modules/invoices/domain/canary/pinned-reference-invoices.ts, keyed by the
# access key that travels inside the URL. Empty disables the canary, which is
# the right state for a development machine.
# EXAMPLE: <url_da_nota>,<url_da_nota>
NFCE_CANARY_URLS=

# Authentication (dev-only secret; every installation must set its own in production)
JWT_SECRET=c998409c9284a13c9e72a7a889534fe1cfb8f7496e2d8a8953f1d43a8b8acede
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
ARGON2_TIME_COST=3

# Whether the refresh token cookie carries the Secure attribute. FALSE here on
# purpose: Safari drops a Secure cookie on http://localhost, so with true a
# login from an iPhone pointed at the dev machine would not keep a session.
# Refused in production, where it must stay true.
AUTH_COOKIE_SECURE=false

# Rate limiting, per client IP and per route. Each budget is a number of
# requests allowed within a window of seconds; past it the API answers 429 with
# RATE_LIMIT_EXCEEDED and the time to wait. DEFAULT covers every route not named
# below (generous: an authenticated screen makes many calls). AUTH covers
# password attempts (login, change-password). RECOVERY covers the routes that
# send mail or spend a reset token (forgot-password, reset-password). The health
# check is never limited. To loosen it in development, raise the numbers; there
# is no switch to turn it off.
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_RECOVERY_LIMIT=5
RATE_LIMIT_RECOVERY_WINDOW_SECONDS=3600

# How many reverse proxies sit between the internet and this process: it decides
# which address the rate limit counts a client under. 1 for a single proxy or
# platform router (nginx, Caddy, Traefik, Railway, Render, Fly...), 2 for e.g. a
# CDN in front of that, 0 when the API is reached directly. A count and never
# "true": the leftmost entry of X-Forwarded-For is written by the client.
# REQUIRED in production, with no default on purpose: assuming no proxy behind
# one puts every client under the proxy's address (the limit then locks everyone
# out together), and assuming one without it lets a client choose its own address
# in a header. Empty in development means 0.
TRUST_PROXY=

# Database backup (scripts/backup/db-dump.sh, scripts/backup/db-restore.sh).
# Credentials are NOT repeated here: both scripts read DATABASE_URL above.

# Where db-dump.sh writes archives. Ignored by git.
BACKUP_DIR=./backups
# Where psql/pg_dump/pg_restore come from:
# auto uses the host client when there is one and falls back to the compose
# container; local forces the host client; docker forces the container.
PG_CLIENT_MODE=auto

# Audit trail retention (§15.2)
AUDIT_LOG_RETENTION_DAYS=180
REQUEST_LOG_RETENTION_DAYS=30

# Image storage (Materials & CompositeProducts)

# LOCAL_DISK || S3
STORAGE_PROVIDER=LOCAL_DISK
UPLOADS_DIR=./uploads
MAX_IMAGE_UPLOAD_SIZE_BYTES=5242880

S3_BUCKET_NAME=craftstock-images
S3_REGION=us-east-1
# Public read base of the bucket, which a stored key is appended to. Required
# when STORAGE_PROVIDER is S3. Comes from the environment rather than being
# assembled from bucket and region, because the installation may sit behind a
# CDN or a custom domain. Bucket policy: docs/DEPLOY.md.
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Operational alerts (unhandled errors, and the NFC-e source canary)

# CONSOLE writes the alert to the structured log; SMTP mails it.
NOTIFICATION_SENDER=CONSOLE
# How long one error type stays quiet after an alert for it went out.
ERROR_ALERT_THROTTLE_SECONDS=300

# Mail to people (the password reset link). CONSOLE writes the message to the
# log instead of sending it, link included, so it can be read in development.
# Outside development it records only who it was for and the subject, since the
# link is as good as a password. Use SMTP to actually deliver it.
EMAIL_SENDER=CONSOLE
# Required only when EMAIL_SENDER=SMTP.
EMAIL_FROM=

# Connection to the SMTP server, shared by alerts and mail to people. Required
# when either NOTIFICATION_SENDER or EMAIL_SENDER is SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# One address, or several separated by commas.
ALERT_EMAIL_TO=
